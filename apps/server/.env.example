# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
RUN_API=true                    # Set to 'false' to disable Express (worker-only process)
RUN_WORKERS=true                # Set to 'false' to disable the lesson ingestion worker

# ── Firebase Admin SDK (REQUIRED — Firestore stores lessons, chunks, chat sessions) ──
# Firebase console → Project settings → Service accounts → Generate new private key
# Option A: individual fields
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"
# Option B: the whole service-account JSON on one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Redis / BullMQ (REQUIRED — lesson ingestion queue) ──────────────────────
# Local: redis://127.0.0.1:6379
# Upstash: rediss://default:TOKEN@your-upstash-url.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Qdrant Vector Database (lesson transcript search) ───────────────────────
# Optional in development (falls back to keyword search); required in production.
# Local: http://127.0.0.1:6333   Qdrant Cloud: https://your-cluster.qdrant.io:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ── NVIDIA NIM (REQUIRED — lesson chat + embeddings) ────────────────────────
# https://build.nvidia.com → Get API key
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
CHAT_PROVIDER=nvidia
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ── Google Gemini (OPTIONAL — lesson metadata + query rewriting; uses NVIDIA if empty) ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── AssemblyAI (needed only for uploaded-video lessons; YouTube uses captions) ──
ASSEMBLYAI_API_KEY=your-assemblyai-key
ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2
TRANSCRIPTION_PROVIDER=assemblyai

# ── Video File Storage ──────────────────────────────────────────────────────
# 'local' (development) | 'r2' (Cloudflare R2, large files) | 'supabase' (free plan caps files at ~50 MB)
STORAGE_PROVIDER=local
# Keep equal to the client VITE_MAX_UPLOAD_MB and within the storage provider's per-file limit
MAX_VIDEO_UPLOAD_MB=50
# Lifetime of signed upload/playback links (applies to both R2 and Supabase)
SUPABASE_SIGNED_URL_TTL_SECONDS=3600

# Cloudflare R2 — only when STORAGE_PROVIDER=r2 (private bucket)
# Dashboard → R2 → Manage API tokens → Create token (Object Read & Write, scoped to the bucket)
# The bucket needs a CORS rule allowing PUT from your frontend origin(s).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lesson-videos

# Supabase Storage — only when STORAGE_PROVIDER=supabase (private bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=workspace-assets

# ── Demo protection ─────────────────────────────────────────────────────────
# Visitors can only delete lessons they added; deleting other lessons (e.g. prepared demo
# content) needs this passcode. Always enforced when NODE_ENV=production (fails closed even if
# this is empty); locally only when set. Team browsers: open the site once with ?team=<passcode>.
DEMO_ADMIN_PASSCODE=

# Reverse proxies in front of the app (Railway/Render/Cloud Run = 1). Defaults to 1 when
# NODE_ENV=production, off locally. Needed so rate limits apply per visitor.
# TRUST_PROXY=1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Production: list your live frontend URL(s), e.g. https://sheryai.vercel.app
# Also set FRONTEND_URL to the same URL, and add it to your storage bucket's CORS rule.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ALLOW_VERCEL_PREVIEWS=false     # 'true' allows *.vercel.app preview URLs
